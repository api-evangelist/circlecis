{
  "opencollection": "1.0.0",
  "info": {
    "name": "CircleCI REST API V2 Context Workflow API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Circle-Token",
      "value": "{{Circle-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Workflow",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cancel a workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://circleci.com/api/v2/workflow/:id/cancel",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Cancels a running workflow."
        }
      ]
    }
  ],
  "bundled": true
}